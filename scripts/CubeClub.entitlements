<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets JavaScriptCore compile the solver. Without it the general solver's
	     first run builds its tables about 20 times slower (about 15 s instead of under 1 s). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- The hardened runtime of Developer ID builds blocks the camera without this.
	     macOS still asks the user first (NSCameraUsageDescription). -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
